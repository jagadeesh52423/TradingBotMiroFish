  "signal": {
    "strategy": "blended",
    "confidence_weights": {
      "no_nse": {"tf": 0.6, "sim": 0.4},
      "with_nse": {"tf": 0.5, "sim": 0.3, "nse": 0.2}
    },
    "news_override": {
      "neg_threshold": -0.3,
      "weak_confidence": 0.55
    },
    "min_confidence_threshold": 0.0,
    "min_bars_for_signal": 10,
    "news_only": {
      "buy_threshold": 0.15,
      "sell_threshold": -0.15,
      "min_filings": 1,
      "confidence_params": {
        "score_weight": 0.7,
        "filing_weight": 0.3,
        "max_expected_filings": 5
      }
    }
  },
  "nse": {
    "lookback_days": 7,
    "cache_ttl_seconds": 900,
    "sentiment_engine": "ai",
    "ai_model": "claude-sonnet-4-5-20250929",
    "ollama_model": "qwen3:8b",
    "ollama_host": "http://localhost:11434",
    "ai_catalyst": {
      "enabled": false
    }
  },
  "news": {
    "google": {
      "enabled": true,
      "lookback_days": 7,
      "max_items": 20,
      "cache_ttl_seconds": 900,
      "query_template": "\"{symbol}\" (stock OR share) when:{lookback}d"
    },
    "usfda": {
      "enabled": true,
      "limit": 10,
      "symbol_map": {
