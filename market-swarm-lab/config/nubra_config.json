      "enabled": true,
      "subreddits": ["IndianStreetBets", "IndianStockMarket", "DalalStreetTalks"],
      "limit": 15
    }
  },
  "delivery": {
    "auto_fetch": true,
    "conviction_flag": {
      "enabled": true,
      "trailing_days": 20
    }
  },
  "watchlist": {
    "enabled": true,
    "weights": {
      "catalyst": 0.30, "sector": 0.25, "band": 0.15, "liquidity": 0.15, "fno": 0.15
    }
  },
  "fno": {
    "conviction_flag": {
      "enabled": true
    }
  },
  "pre_open": {
    "conviction_flag": {
      "enabled": true,
      "big_gap_pct": 1.0,
      "min_qty": 50000
    }
  },
  "deals": {
    "enabled": true
  },
  "shareholding": {
    "enabled": true
  },
  "runner": {
    "max_workers": 3,
    "inter_batch_sleep_secs": 0.5
  },
  "futures": {
    "provider": "nubra_futures",
    "underlyings": ["NIFTY", "BANKNIFTY"]
